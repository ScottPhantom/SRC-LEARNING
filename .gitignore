.DS_Store

# Local content and user-generated data must never be published.
DATA/
.src-learning-test/
.src-learning-recovery/
user_data/
uploads/
exports/
backups/

# Databases and their sidecar/journal files.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Runtime logs and local environment/secrets.
*.log
*.log.*
.env
.env.*
!.env.example
catalog_source_url.txt
*.pem
*.key
credentials*
secrets*

# Common data exports.
*.csv
*.tsv
*.jsonl
*.ndjson
*.parquet

# Mock Exam reports generated from local database statistics.
**/docs/*/Date-of-Statistical_*/
/docs/Test_Ver/*/Date-of-Statistical_*/

# Subject Statistics snapshots contain local study progress and answer keys.
/docs/subject_statistics.json
/docs/Test_Ver/subject_statistics.json
/docs/.subject-statistics-*.tmp
/docs/Test_Ver/.subject-statistics-*.tmp

build/
dist/
ocr_failures/

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store

# Local content and user-generated data must never be published.
DATA/
user_data/
uploads/
exports/
backups/

# Databases and their sidecar/journal files.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Runtime logs and local environment/secrets.
*.log
*.log.*
.env
.env.*
!.env.example
*.pem
*.key
credentials*
secrets*

# Common data exports.
*.csv
*.tsv
*.jsonl
*.ndjson
*.parquet

# Mock Exam reports generated from local database statistics.
**/docs/*/Date-of-Statistical_*/

build/
dist/
ocr_failures/
.vscode

# Local AI agent and agentic IDE state must never be published.
**/.agents/
**/.claude/
**/.codex/
**/.cursor/
**/.gemini/
**/.grok/
**/.kiro/
**/.windsurf/
**/.antigravity/
**/.antigravity-ide/
**/.continue/
**/.aider*
**/.mcp.json
**/.mcp/
**/.ignore
**/CLAUDE.local.md
**/GEMINI.local.md
**/.cursorrules
**/.windsurfrules

# Repository-owned Claude + Graft integration is intentionally versioned.
# Other nested/local .claude directories remain ignored by the rule above.
!/.claude/
!/.claude/helpers/
!/.claude/helpers/graft-hooks.cjs
!/.claude/helpers/graft-statusline.cjs
!/.claude/settings.json
!/.claude/skills/
!/.claude/skills/graft/
!/.claude/skills/graft/SKILL.md

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

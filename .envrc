# Optional automatic activation for direnv and POSIX-compatible shells.
# Native Windows PowerShell and Command Prompt users can follow README.md.
VENV_ROOT="$PWD/.venv"

if [ -d "$VENV_ROOT/bin" ]; then
  VENV_BIN="$VENV_ROOT/bin"
elif [ -d "$VENV_ROOT/Scripts" ]; then
  VENV_BIN="$VENV_ROOT/Scripts"
else
  VENV_BIN=""
fi

if [ -n "$VENV_BIN" ]; then
  export VIRTUAL_ENV="$VENV_ROOT"
  export PATH="$VENV_BIN:$PATH"
fi

unset VENV_ROOT VENV_BIN
